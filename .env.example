# Copy to .env and fill in the values: cp .env.example .env
# Only variables prefixed with VITE_ are exposed to the app (import.meta.env.VITE_*).
# They are embedded at build time, so they are public: never put secrets in VITE_ variables.
# Declare every variable in src/vite-env.d.ts to get it typed.

VITE_API_URL=
# deployment environment, e.g. staging; defaults to the Vite mode (development / production)
VITE_ENV=

# Sentry error tracking, disabled when VITE_SENTRY_DSN is empty
VITE_SENTRY_DSN=
